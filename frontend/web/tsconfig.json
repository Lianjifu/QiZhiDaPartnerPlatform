{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "baseUrl": "..",
    "paths": {
      "@/*": ["web/src/*"],
      "@qzda/web-ui": ["packages/ui/src/index.tsx"],
      "@qzda/web-api": ["packages/api/src/index.ts"],
      "@qzda/web-types": ["packages/types/src/index.ts"],
      "@qzda/web-hooks": ["packages/hooks/src/index.ts"],
      "@qzda/web-utils": ["packages/utils/src/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
