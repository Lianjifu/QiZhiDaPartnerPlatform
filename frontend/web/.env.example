# API 模式：api（默认，真实控制面）| demo（浏览器内 mock，不请求后端）
VITE_API_MODE=api
# 推荐留空：浏览器请求同源 /api，由 Vite 代理到网关
VITE_API_BASE=

# 需要浏览器直连网关时再填写：
# VITE_API_BASE=http://127.0.0.1:8089
# VITE_API_DIRECT=true

# 代理目标（仅 Vite 进程读取）。
#   默认 gateway :8089（monolith / `make run` / `make compose-up-monolith`）。
#   直连 qzda-app 时（`make run-app` 单进程模式，gateway 不启动）改为：
#     VITE_PROXY_TARGET=http://127.0.0.1:8100
# VITE_PROXY_TARGET=http://127.0.0.1:8089

# 演示环境（浏览器内 mock，可不启后端）：npm run dev:demo
# VITE_API_MODE=demo

# 跨标签会话同步（BFF / pmsop 联调时可关闭以避免噪音）
# VITE_SESSION_SYNC_ENABLED=false
