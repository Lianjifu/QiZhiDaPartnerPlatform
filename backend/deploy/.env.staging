# Staging / pre-prod hardened defaults (source via: make compose-up-staging)
QZDA_ENV=staging
QZDA_BAN_MOCK_TOKEN=1
QZDA_BAN_DEMO_TOKEN=1
QZDA_FORCE_OIDC=1
QZDA_ALLOW_PASSWORD_LOGIN=0
QZDA_OIDC_ISSUER=http://127.0.0.1:5556/dex
QZDA_OIDC_CLIENT_ID=de-core
QZDA_OIDC_CLIENT_SECRET=de-core-secret
QZDA_OIDC_AUTH_PATH=/auth
QZDA_OIDC_REDIRECT_URL=http://127.0.0.1:8089/api/auth/oidc/callback
QZDA_OPA_URL=http://127.0.0.1:8181
QZDA_OPENSEARCH_URL=http://127.0.0.1:9200
# policy evaluate 在 de-sys；collab/cap 经 compose 默认 QZDA_*_POLICY_URL=http://de-sys:8100
QZDA_SANDBOX_RUN_SECRET=change-me-staging-skill-run
