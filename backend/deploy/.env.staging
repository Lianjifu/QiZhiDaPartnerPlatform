# Staging / pre-prod hardened defaults (source via: make compose-up-staging)
DE_ENV=staging
DE_BAN_MOCK_TOKEN=1
DE_BAN_DEMO_TOKEN=1
DE_FORCE_OIDC=1
DE_ALLOW_PASSWORD_LOGIN=0
DE_OIDC_ISSUER=http://127.0.0.1:5556/dex
DE_OIDC_CLIENT_ID=de-core
DE_OIDC_CLIENT_SECRET=de-core-secret
DE_OIDC_AUTH_PATH=/auth
DE_OIDC_REDIRECT_URL=http://127.0.0.1:8089/api/auth/oidc/callback
DE_OPA_URL=http://127.0.0.1:8181
DE_OPENSEARCH_URL=http://127.0.0.1:9200
# policy evaluate 在 de-sys；collab/cap 经 compose 默认 DE_*_POLICY_URL=http://de-sys:8100
DE_SANDBOX_RUN_SECRET=change-me-staging-skill-run
