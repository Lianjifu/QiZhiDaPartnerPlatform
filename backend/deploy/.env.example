# Copied by Makefile when Compose infra is up (coarse control plane).
# Must reach Docker de-postgres (PG16). Do not run Homebrew Postgres on :5432.
DE_DATABASE_URL=postgres://de:de@127.0.0.1:5432/digital_employee?sslmode=disable
DE_REDIS_URL=redis://127.0.0.1:6379/0
# Data mode: demo | development | staging | production
# - demo: in-memory demonstration seed, no Postgres writes
# - development: Postgres persist, no demo seed on empty DB (default local)
# - staging/production: dual approval + Vault required
DE_ENV=development
# Ban demonstration mock-*-token (also used as DE_BAN_DEMO_TOKEN)
DE_BAN_MOCK_TOKEN=0
DE_BAN_DEMO_TOKEN=0
# Force OIDC-only login (rejects POST /api/auth/login)
# DE_FORCE_OIDC=1
# Escape hatch when BAN=1 but local password login still needed
# DE_ALLOW_PASSWORD_LOGIN=1
# Hardened stack: make compose-up-staging (loads deploy/.env.staging)
# Optional OIDC (Authentik/Dex): leave empty for local stub callback (code=admin|user|audit)
# DE_OIDC_ISSUER=http://127.0.0.1:9000/application/o/de/
# DE_OIDC_CLIENT_ID=de-core
# DE_OIDC_CLIENT_SECRET=
# DE_OIDC_REDIRECT_URL=http://127.0.0.1:8089/api/auth/oidc/callback
# DE_OIDC_AUTH_PATH=/authorize
# Optional overrides when discovery paths differ:
# DE_OIDC_TOKEN_URL=
# DE_OIDC_USERINFO_URL=
# Allow code=admin|user|audit even when issuer is set (local demos only)
# DE_OIDC_ALLOW_DEV_CODES=0
# Optional Vault (compose profile: full)
# DE_VAULT_ADDR=http://127.0.0.1:8200
# DE_VAULT_TOKEN=de-vault-root
# DE_VAULT_KV_MOUNT=secret
# Model control-plane (production-oriented)
# DE_REQUIRE_VAULT=1
# DE_MODEL_PROBE_TIMEOUT=8
# Allow loopback/private provider baseUrl (Ollama, internal gateway). Cap only.
# DE_MODEL_ALLOW_PRIVATE=1
# DE_MODEL_DISCOVER_FALLBACK=0
# （默认关闭静态目录回落；仅当无法访问真实供应商时再设为 1）
# 用量硬门禁：生产/staging 默认开启；本地默认关。设 0 可关，设 1 可在非生产强制开
# DE_MODEL_BUDGET_ENFORCE=0
# Collab → Cap model invoke (compose default: http://de-cap:8102; local: http://127.0.0.1:8102)
# DE_CAP_URL=http://127.0.0.1:8102
# Optional escape hatch when no published provider (OpenAI-compatible)
# DE_LLM_BASE_URL=https://api.openai.com/v1
# DE_LLM_API_KEY=
# DE_LLM_MODEL=gpt-4o-mini
# Per-candidate timeout when trying multiple providers (seconds, default 8)
# DE_MODEL_CANDIDATE_TIMEOUT=45
# DE_MODEL_STANDBY_TIMEOUT=20
# DE_COPILOT_STREAM_TIMEOUT=300
# Local in-process chat when no remote provider works (default on; set 0 to disable)
# DE_EMBEDDED_CHAT=1
# Legacy agent-runtime stub (default off — never surface [runtime stub] as success)
# DE_ALLOW_RUNTIME_STUB=0
# Optional Temporal (compose: make compose-up-temporal && make worker)
# DE_TEMPORAL_HOST=127.0.0.1:7233
# 生产默认 Temporal 不可达不回落 local；非生产可设 1 强制同样行为
# DE_TEMPORAL_FAIL_CLOSED=1
# 多活最小集：standby 实例拒绝写入（读请求仍可）
# DE_REPLICA_MODE=active
# DE_INSTANCE_ID=node-a
# 生产评测门禁（未设则生产默认 recall 0.7 / score 80）
# DE_EVAL_RECALL_MIN=0.7
# DE_EVAL_SCORE_MIN=80
# Optional Dex OIDC (compose: make compose-up-oidc)
# DE_OIDC_ISSUER=http://127.0.0.1:5556/dex
# DE_OIDC_CLIENT_ID=de-core
# DE_OIDC_CLIENT_SECRET=de-core-secret
# DE_OIDC_AUTH_PATH=/auth
# Optional Kafka/Redpanda audit topic (compose: make compose-up-kafka)
# DE_KAFKA_BROKERS=127.0.0.1:19092
# DE_KAFKA_AUDIT_TOPIC=de.audit.v1
# Optional Milvus for RAG (compose: make compose-up-milvus; pip install -r python/rag/requirements.txt)
# DE_MILVUS_URI=http://127.0.0.1:19530
# Or Milvus-Lite file URI without Docker:
# DE_MILVUS_URI=./milvus_rag.db
# Optional external OPA (compose: make compose-up-opa); unset = embedded baseline rules
# DE_OPA_URL=http://127.0.0.1:8181
# Optional OpenSearch audit index/search (compose: make compose-up-search); still dual-writes PG
# DE_OPENSEARCH_URL=http://127.0.0.1:9200
# DE_OPENSEARCH_AUDIT_INDEX=de-audit
# Optional Authentik (compose: make compose-up-authentik; see deploy/authentik/README.md)
# DE_OIDC_ISSUER=http://127.0.0.1:9000/application/o/de/
# DE_OIDC_CLIENT_ID=de-core
# DE_OIDC_CLIENT_SECRET=de-core-secret
# Shared HMAC secret for skill sandbox RunToken (control plane + sandbox)
# DE_SANDBOX_RUN_SECRET=de-skill-run-dev
# DE_SANDBOX_SANDBOX=gvisor-local
# Observability: make compose-up-obs → Prometheus :9090 / Grafana :3000
# SPIFFE trust domain for cert SANs / identity helpers
# DE_SPIFFE_TRUST_DOMAIN=de.local
# Skill isolation (coarse compose sets REQUIRE_ISOLATION=1 on de_exec_net)
# DE_SANDBOX_REQUIRE_ISOLATION=0
# collab/cap → de-sys evaluate（本机调试）；独立 de-policy 时改为 :8104
# DE_POLICY_URL=http://127.0.0.1:8100
# 切开 policy/audit 进程时：de-sys 设 DE_CROSSCUTTING_SPLIT=1，并启动 de-policy :8104 / de-audit :8105
# DE_CROSSCUTTING_SPLIT=0
# standby 连从库（make compose-up-replica → :5433；已有 PG volume 需补 replication hba 或 down -v）
# DE_DATABASE_REPLICA_URL=postgres://de:de@127.0.0.1:5433/digital_employee?sslmode=disable
# DE_REPLICA_MODE=active
# Public base for Feishu webhook URL hints (e.g. https://api.example.com or http://127.0.0.1:8089)
# DE_PUBLIC_BASE_URL=http://127.0.0.1:8089
