# 单进程 Docker 部署环境变量(复制为 deploy/.env 后生效)。
#
# Compose / dev-stack 通过 docker compose 或本机 export 自动注入到
# qzda-app / qzda-sandbox / qzda-rag / qzda-gateway 容器。

# === 必填:数据源 ===
# postgres + redis 是 docker compose 自带,默认配置(用户 de,库 digital_employee)。
# 本机联调时 QZDA_DATABASE_URL / QZDA_REDIS_URL 由 run-stack.sh / Makefile 自动注入。
QZDA_DATABASE_URL=postgres://de:de@127.0.0.1:5432/digital_employee?sslmode=disable
QZDA_REDIS_URL=redis://127.0.0.1:6379/0

# === 必填:运行时 ===
# QZDA_MODE=dev|pro
#   - dev(默认):PG 持久化(空库不灌 seed);允许 mock 身份与 mock token、内置对话与 runtime stub
#   - pro:双人审批 + Vault required + OIDC 登录 + 强制签名校验;禁用 mock / 内置对话 / 开发密钥
QZDA_MODE=dev
# 仅 dev 有效:memory = 内存 + ACME seed,不写 PG;pg(默认)= 持久化
# QZDA_DATA_BACKEND=memory

# === 必填:监听 / 进程内 toggle ===
QZDA_APP_ADDR=:8100
QZDA_SERVICE=app
QZDA_RUNTIME_MODE=local
QZDA_PUBLIC_BASE_URL=http://127.0.0.1:8089

# === 沙箱(gVisor / runsc) ===
# 启用 runsc:docker run --runtime=runsc 或 QZDA_SANDBOX_RUNTIME=runsc (host 需预装 runsc)
QZDA_SANDBOX_RUNTIME=runc
QZDA_SANDBOX_SANDBOX=runsc-local
# 控制面与 qzda-sandbox 共享的 RunToken HMAC 密钥。
# 生产:openssl rand -hex 32 > deploy/secrets/skill-run-secret 后挂进容器。
QZDA_SANDBOX_RUN_SECRET=qzda-skill-run-dev
# 沙箱信任的 Ed25519 signer key IDs(CSV),签名校验 fail-closed。
QZDA_SANDBOX_TRUSTED_KEY_IDS=ed25519:dev-placeholder

# === 安全 / 鉴权 ===
# JWT 签名密钥;留空用 dev fallback(pro 必填 32 字节随机串)
# QZDA_JWT_SECRET=
# OIDC(pro 必填):企业 IdP 的 issuer / client;回跳地址为前端回调页(本地默认即可),需与 IdP 登记的 redirect_uri 一致
# QZDA_OIDC_ISSUER=https://idp.example.com/application/o/qizhida/
# QZDA_OIDC_CLIENT_ID=
# QZDA_OIDC_CLIENT_SECRET=
# QZDA_OIDC_REDIRECT_URL=http://127.0.0.1:8010/login/oidc/callback

# === 模型 / 推理 ===
# OpenAI-compatible 远程供应商(可留空走 embedded chat)
QZDA_LLM_BASE_URL=
QZDA_LLM_API_KEY=
QZDA_LLM_MODEL=gpt-4o-mini
# 候选供应商探测超时(秒,默认 45)
QZDA_MODEL_CANDIDATE_TIMEOUT=45
# 单供应商请求超时(秒,默认 20)
QZDA_MODEL_STANDBY_TIMEOUT=20
# Copilot 流式响应超时(秒,默认 300)
QZDA_COPILOT_STREAM_TIMEOUT=300
# 1 = 允许 loopback / 私网 baseUrl(Ollama / 内网网关)
QZDA_MODEL_ALLOW_PRIVATE=0

# === RAG / 向量检索 ===
# 单进程 Docker 部署默认推荐 pgvector:向量存在控制面同一个 PG 实例,
# 无需额外容器。留空 = 进程内 vector-memory(demo 用,不持久)。
# 容器内 compose 已默认指向 postgres:5432;本机联调时与 QZDA_DATABASE_URL 一致即可。
QZDA_PGVECTOR_URL=postgres://de:de@127.0.0.1:5432/digital_employee?sslmode=disable
# 或 QZDA_PGVECTOR_URL=vector-memory   # 强制走内存 backend

# === 可观测(轻量,无需额外容器) ===
# Prometheus :9090 / Grafana :3000 由本机 prometheus 进程独立拉取 qzda-app :9100/metrics
# (compose.yml 不含 obs profile,改用 host agent)

# === 不再生效 / 历史保留 ===
# 以下变量在 M10 折叠 / Phase 4 重命名后已无意义,保留仅为脚本兼容:
#   QZDA_LISTEN_ADDR (等价 QZDA_APP_ADDR)
#   QZDA_WORKSPACE / QZDA_WORKSPACE_ID (从 login user.tenantId 取)
#   QZDA_TOKEN (从 localStorage.token 取)
